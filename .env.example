# Copy to .env and fill in real values. .env is git-ignored; NEVER put real
# values in this file (the repo is public). Then: chmod 600 .env

# --- API keys ---
BALLDONTLIE_KEY=your_api_key_here

# --- Database (read-write role used by the pipeline scripts) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sports_hub
DB_USER=your_db_user
DB_PASSWORD=change_me

# --- Database (SELECT-only role used by the public dashboard) ---
DASHBOARD_DB_USER=dashboard_ro
DASHBOARD_DB_PASSWORD=change_me

# --- Backups (optional; scripts/backup_db.sh and scripts/restore_test.sh) ---
# Folder for nightly dumps (default: $HOME/backups)
#BACKUP_DIR=/home/your_user/backups
# Days of dumps to keep (default: 30)
#BACKUP_KEEP_DAYS=30
# Scratch database the weekly restore test loads into (default shown)
#RESTORE_TEST_DB=sports_hub_restore_test

# --- Alerts and logging (optional; scripts/notify.py, scripts/log_setup.py) ---
# ntfy.sh topic your phone subscribes to. Anyone who knows it can read/send, so use a
# long random value. Never commit it.
#NTFY_TOPIC=sportshub-some-long-random-string
# Only if you self-host ntfy (default https://ntfy.sh)
#NTFY_URL=https://ntfy.sh
# Ping URL from healthchecks.io for the nightly pipeline; a missing ping is what alerts you
# that a run never happened. Each job can have its own check (all optional):
#HEALTHCHECK_URL=https://hc-ping.com/your-uuid
#HEALTHCHECK_REFRESH_URL=https://hc-ping.com/your-other-uuid
#HEALTHCHECK_BACKUP_URL=https://hc-ping.com/your-other-uuid
#HEALTHCHECK_RESTORE_URL=https://hc-ping.com/your-other-uuid
# Folder for log files (default: logs/ in the project)
#LOG_DIR=/path/to/logs
